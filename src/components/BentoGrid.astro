---
import { bentoColors, svgIcons } from "../lib/colors";
import copy from "../data/copy.json";

// Layout true Bento: 4 columnas en lg+
// gemini: 2 cols × 2 rows (la card grande)
// youtube: 1 col × 1 row
// storage: 1 col × 1 row
// workspace: 2 cols × 1 row
// ── Layout ──
// lg: [gemini 2×2][youtube 1][storage 1]
//     [gemini 2×2][workspace 2 cols]
// md: [gemini 2 cols][youtube 1 col]
//     [storage 1 col][workspace 2 cols]
---

<section class="py-20 md:py-28 px-4 sm:px-6 max-w-7xl mx-auto">
  <!-- Header -->
  <div class="text-center mb-16 md:mb-20">
    <span class="inline-block text-xs font-bold tracking-[0.2em] text-slate-500 uppercase mb-4">
      Servicios incluidos
    </span>
    <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight mb-5">
      {copy.bento.title}
    </h2>
    <p class="text-slate-400 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
      {copy.bento.subtitle}
    </p>
  </div>

  <!-- True Bento Grid: 3 cols md, 4 cols lg -->
  <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-5 auto-rows-[auto]">
    {
      copy.bento.cards.map((card) => {
        const c = bentoColors[card.color] ?? bentoColors.indigo;
        const icon = svgIcons[card.id] ?? "";
        const isGemini = card.id === "gemini";

        return (
          <div
            class={`group relative overflow-hidden rounded-3xl border p-6 sm:p-8 transition-all duration-500 bg-slate-900/60 backdrop-blur-sm card-lift ${
              c.border
            } ${
              isGemini
                ? "md:col-span-2 lg:col-span-2 lg:row-span-2"
                : card.span
            }`}
          >
            {/* Glow de fondo */}
            <div
              class={`absolute -top-20 -right-20 w-80 h-80 rounded-full blur-[100px] pointer-events-none transition-all duration-700 ${
                isGemini ? "opacity-40 group-hover:opacity-70" : "opacity-30 group-hover:opacity-60"
              } ${c.glow}`}
              aria-hidden="true"
            ></div>

            {/* Borde interno decorativo (glass edge) */}
            <div class="absolute inset-0 rounded-3xl pointer-events-none bg-linear-to-br from-white/[0.03] via-transparent to-transparent"></div>

            <div class="relative z-10 h-full flex flex-col">
              {/* Tag + Icono */}
              <div class="flex items-center justify-between mb-5">
                <span class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[11px] font-bold uppercase tracking-wider border ${c.tag}`}>
                  {card.tag}
                </span>
                <div class={`w-9 h-9 rounded-xl ${c.featureBg} flex items-center justify-center transition-opacity duration-300 ${
                  isGemini ? "opacity-80" : "opacity-50 group-hover:opacity-80"
                }`}>
                  <svg class={`w-4 h-4 fill-current ${isGemini ? c.featureText : ""}`} viewBox="0 0 24 24">
                    <path d={icon} />
                  </svg>
                </div>
              </div>

              {/* Título + Subtítulo */}
              <h3 class={`font-bold text-white mb-2 ${
                isGemini ? "text-2xl sm:text-3xl lg:text-4xl" : "text-xl sm:text-2xl"
              }`}>
                {card.title}
              </h3>
              <p class={`font-semibold mb-4 ${isGemini ? "text-base" : "text-sm"} ${c.featureText}`}>
                {card.subtitle}
              </p>

              {/* Descripción */}
              <p class={`text-slate-400 leading-relaxed mb-5 grow ${isGemini ? "text-sm sm:text-base" : "text-sm"}`}>
                {card.description}
              </p>

              {/* Features pills */}
              <div class={`grid ${isGemini ? "grid-cols-2 gap-2.5" : "grid-cols-1 gap-2"} mt-auto`}>
                {card.features.map((feature: string) => (
                  <div
                    class={`flex items-start gap-2 p-2.5 rounded-lg text-xs font-medium border transition-all duration-300 ${
                      c.featureBg
                    } ${isGemini ? "group-hover:border-opacity-80" : ""}`}
                  >
                    <svg class={`w-3.5 h-3.5 mt-0.5 shrink-0 ${c.featureText}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{feature}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</section>
