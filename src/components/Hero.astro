---
import copy from "../data/copy.json";
import {
  buildWhatsAppLink,
  WHATSAPP_ICON_PATH,
  CHECKMARK_ICON_PATH,
} from "../lib/whatsapp";

const waLink = buildWhatsAppLink();
const { availableSlots } = copy.pricing;
---

<section class="relative overflow-hidden pt-24 pb-5 md:pt-36 md:pb-5">
  <!-- ═══ CAPA 1: Glows ambientales profundos ═══ -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[600px] bg-gemini-600/10 rounded-full blur-[180px] pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute top-1/3 right-1/4 w-[500px] h-[350px] bg-purple-500/6 rounded-full blur-[140px] pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-[400px] h-[250px] bg-gemini-500/4 rounded-full blur-[120px] pointer-events-none"
    aria-hidden="true"
  >
  </div>

  <!-- ═══ CAPA 2: Partículas decorativas sutiles ═══ -->
  <div
    class="absolute inset-0 pointer-events-none overflow-hidden"
    aria-hidden="true"
  >
    <div
      class="absolute top-[15%] left-[10%] w-1.5 h-1.5 rounded-full bg-gemini-400/30 motion-safe:animate-float"
    >
    </div>
    <div
      class="absolute top-[25%] right-[15%] w-1 h-1 rounded-full bg-purple-400/25 motion-safe:animate-float-slow anim-delay-200"
    >
    </div>
    <div
      class="absolute top-[55%] left-[20%] w-1 h-1 rounded-full bg-gemini-300/20 motion-safe:animate-float-slow anim-delay-400"
    >
    </div>
    <div
      class="absolute top-[40%] right-[25%] w-1.5 h-1.5 rounded-full bg-gemini-400/20 motion-safe:animate-float anim-delay-300"
    >
    </div>
    <div
      class="absolute top-[70%] left-[60%] w-1 h-1 rounded-full bg-purple-300/15 motion-safe:animate-float-slow anim-delay-100"
    >
    </div>
  </div>

  <!-- ═══ CONTENIDO ═══ -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center relative z-10">
    <!-- Eyebrow — aparece primero -->
    <div class="animate-fade-in">
      <span
        class="inline-block text-xs sm:text-sm font-bold tracking-[0.2em] text-gemini-400 uppercase mb-6"
      >
        {copy.hero.eyebrow}
      </span>
    </div>

    <!-- Título principal — slide up 200ms delay, texto con gradiente staggered -->
    <h1
      class="animate-slide-up-delayed text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white mb-8 leading-[1.06] max-w-5xl mx-auto"
    >
      <span class="animate-fade-in anim-delay-200">
        {copy.hero.titleLine1}
        <br />
      </span>
      <span class="animate-scale-in text-gradient-gemini">
        {copy.hero.titleHighlight}
      </span>
    </h1>

    <!-- Subtítulo -->
    <p
      class="animate-fade-in anim-delay-300 text-base sm:text-lg text-slate-400 max-w-3xl mx-auto mb-10 leading-relaxed font-normal"
    >
      {copy.hero.subtitle}
    </p>

    <!-- ═══ PRICE ANCHOR CARD — Rediseñada ═══ -->
    <div
      class="animate-scale-in inline-flex flex-col sm:flex-row items-center justify-center gap-6 bg-slate-900/90 border border-slate-700/80 p-5 sm:p-6 rounded-2xl mb-10 shadow-2xl backdrop-blur-xl glow-ring-indigo max-w-lg mx-auto"
    >
      {/* PRECIO VIEJO — visualmente desfavorecido */}
      <div class="text-center sm:text-left opacity-70">
        <div
          class="text-[10px] font-semibold uppercase tracking-widest text-slate-500 mb-1.5"
        >
          {copy.hero.priceAnchorLabel}
        </div>
        <div class="relative inline-block">
          <span
            class="text-2xl sm:text-3xl font-bold text-slate-500 line-through decoration-slate-500/60 decoration-2"
          >
            {copy.hero.priceAnchorValue}
          </span>
          {/* X sutil sobre precio tachado */}
          <span
            class="absolute -top-1 -right-3 text-red-400/60 text-xs font-bold hidden sm:block"
            >✕</span
          >
        </div>
        <div class="text-[10px] text-slate-500 mt-1">
          {copy.hero.priceAnchorHint}
        </div>
      </div>

      {/* FLECHA — ícono de transformación */}
      <div class="hidden sm:flex flex-col items-center gap-1 shrink-0">
        <div class="flex items-center gap-1">
          <div class="w-1 h-3 rounded-full bg-slate-700"></div>
          <div class="w-1 h-3 rounded-full bg-slate-700"></div>
          <div class="w-1 h-3 rounded-full bg-slate-700"></div>
        </div>
        <div
          class="w-10 h-10 rounded-full bg-gemini-500/15 border border-gemini-500/30 text-gemini-400 flex items-center justify-center"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </div>
      </div>
      {/* Flecha mobile */}
      <div
        class="flex sm:hidden items-center justify-center w-8 h-8 rounded-full bg-gemini-500/15 border border-gemini-500/30 text-gemini-400 shrink-0 rotate-90"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>

      {/* PRECIO REAL — heroico, brillante */}
      <div class="text-center sm:text-left">
        <div
          class="text-[10px] font-semibold uppercase tracking-widest text-emerald-400 mb-1.5"
        >
          {copy.hero.groupPriceLabel}
        </div>
        <div
          class="flex items-baseline justify-center sm:justify-start gap-1.5"
        >
          <span class="text-4xl sm:text-5xl font-extrabold text-white"
            >${copy.pricing.monthlyFee}</span
          >
          <span class="text-xs sm:text-sm font-semibold text-slate-400"
            >{copy.pricing.currency}/mes</span
          >
        </div>
        <div
          class="mt-2 inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-[11px] font-bold"
        >
          <svg
            class="w-3 h-3"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="3"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d={CHECKMARK_ICON_PATH}></path>
          </svg>
          {copy.hero.savingsLabel}
        </div>
      </div>
    </div>

    {/* ═══ CTA PRINCIPAL ═══ */}
    <div
      class="animate-fade-in anim-delay-400 flex flex-col sm:flex-row items-center justify-center gap-4 mb-10"
    >
      <a
        href={waLink}
        target="_blank"
        rel="noopener noreferrer"
        class="group w-full sm:w-auto px-8 py-4 rounded-xl bg-linear-to-r from-gemini-500 to-purple-600 text-white font-bold text-lg hover:from-gemini-600 hover:to-purple-700 transition-all duration-300 shadow-xl shadow-gemini-500/25 hover:shadow-gemini-500/40 hover:-translate-y-0.5 flex items-center justify-center gap-3"
      >
        <svg
          class="w-6 h-6 fill-current group-hover:scale-110 transition-transform"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d={WHATSAPP_ICON_PATH}></path>
        </svg>
        {copy.hero.ctaText}
      </a>
    </div>

    {/* ═══ INDICADOR DE ÚLTIMO CUPO ═══ */}
    <div
      class="animate-fade-in anim-delay-500 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-xs"
    >
      {/* Último cupo disponible */}
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-full bg-yt-red/20 border-2 border-yt-red/40 border-dashed flex items-center justify-center text-[10px] font-bold text-red-400 animate-glow-pulse">
          {availableSlots}
        </div>
        <span class="text-slate-400">
          <strong class="text-red-400 font-bold">Último cupo</strong> disponible
        </span>
      </div>

      {/* Activación inmediata */}
      <div class="hidden sm:flex items-center gap-1.5 text-slate-500">
        <svg
          class="w-3.5 h-3.5 text-emerald-500"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d={CHECKMARK_ICON_PATH}></path>
        </svg>
        <span>{copy.hero.activationLabel}</span>
      </div>
    </div>
  </div>
</section>
