---
import copy from "../data/copy.json";
import { buildWhatsAppLink, WHATSAPP_ICON_PATH, CHECKMARK_ICON_PATH, CROSS_ICON_PATH } from "../lib/whatsapp";
import { svgIcons } from "../lib/colors";

const waLink = buildWhatsAppLink();
const { monthlyFee, marketValueIndividual: marketTotal } = copy.pricing;
const pc = copy.priceComparison;
const iconColorMap: Record<string, string> = {
  indigo: "bg-gemini-500/15 border-gemini-500/20",
  red: "bg-red-500/15 border-red-500/20",
  emerald: "bg-emerald-500/15 border-emerald-500/20",
  purple: "bg-purple-500/15 border-purple-500/20",
};
const iconTextMap: Record<string, string> = {
  indigo: "text-gemini-400",
  red: "text-red-400",
  emerald: "text-emerald-400",
  purple: "text-purple-400",
};
---

<section class="py-20 md:py-28 px-4 sm:px-6 bg-slate-950/60 border-y border-slate-800/40">
  <div class="max-w-5xl mx-auto">
    <!-- Encabezado -->
    <div class="text-center mb-14 md:mb-18">
      <span class="inline-block text-xs font-bold tracking-[0.2em] text-slate-500 uppercase mb-4">
        {pc.badge}
      </span>
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white mb-5 tracking-tight">
        {pc.title}
      </h2>
      <p class="text-slate-400 text-base sm:text-lg max-w-3xl mx-auto leading-relaxed">
        Comprar cada servicio por separado cuesta casi <strong class="text-white">4 veces más</strong>.
        En nuestro grupo familiar, accedés a exactamente lo mismo por una fracción del precio.
      </p>
    </div>

    <!-- ═══ HEADER (solo visible en desktop) ═══ -->
    <div class="hidden md:grid grid-cols-12 gap-0 rounded-t-2xl border border-b-0 border-slate-800/70 bg-slate-950/80 text-slate-400 text-xs uppercase tracking-wider font-semibold">
      <div class="col-span-5 py-4 px-6">Servicio / Función</div>
      <div class="col-span-3 py-4 px-4 text-center bg-red-950/10 rounded-tr-2xl">
        <span class="inline-flex items-center justify-center gap-2">
          <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={svgIcons.person}/></svg>
          <span class="text-slate-500">{pc.columns.individual}</span>
        </span>
      </div>
      <div class="col-span-4 py-4 px-4 text-center bg-gemini-950/40 border-l border-gemini-800/30 rounded-tr-2xl">
        <span class="inline-flex items-center justify-center gap-2 text-gemini-400">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={svgIcons.people}/></svg>
          <span>{pc.columns.group}</span>
        </span>
      </div>
    </div>

    <!-- ═══ FILAS — Desktop: grid 12 cols. Mobile: cards stacked ═══ -->
    <div class="space-y-3 md:space-y-0">
      {pc.rows.map((row, i) => {
        const iconBg = iconColorMap[row.iconColor] ?? iconColorMap.indigo;
        const iconText = iconTextMap[row.iconColor] ?? iconTextMap.indigo;
        const icon = svgIcons[row.id] ?? "";
        const hasPrice = row.individualPrice?.length > 0;
        const isLast = i === pc.rows.length - 1;

        return (
          <div class={`group grid grid-cols-1 md:grid-cols-12 md:gap-0 border border-slate-800/70 bg-slate-900/70 md:border-t-0 md:rounded-none rounded-2xl overflow-hidden transition-colors hover:bg-slate-800/30 ${
            isLast ? "md:rounded-b-2xl" : ""
          }`}>
            {/* ═══ MOBILE CARD ═══ */}
            <div class="md:hidden p-5">
              {/* Header: icono + nombre */}
              <div class="flex items-center gap-3 mb-4">
                <div class={`w-8 h-8 rounded-lg ${iconBg} flex items-center justify-center shrink-0`}>
                  <svg class={`w-4 h-4 ${iconText} fill-current`} viewBox="0 0 24 24"><path d={icon}/></svg>
                </div>
                <div>
                  <span class="text-slate-200 font-semibold text-sm">{row.name}</span>
                  <span class="block text-xs text-slate-500">{row.subtitle}</span>
                </div>
              </div>
              {/* Comparación lado a lado */}
              <div class="grid grid-cols-2 gap-3">
                {/* Individual */}
                <div class="flex flex-col items-center p-3 rounded-xl bg-red-950/10 border border-red-900/20">
                  <span class="text-[10px] uppercase tracking-wider text-slate-500 mb-1">Por tu cuenta</span>
                  {hasPrice ? (
                    <span class="text-sm font-bold text-red-400/70 line-through">{row.individualPrice}</span>
                  ) : (
                    <span class="text-xs text-slate-500">{row.individualPrice}</span>
                  )}
                </div>
                {/* Grupo */}
                <div class="flex flex-col items-center p-3 rounded-xl bg-gemini-950/30 border border-gemini-800/30">
                  <span class="text-[10px] uppercase tracking-wider text-gemini-400 mb-1">En el grupo</span>
                  <span class="inline-flex items-center gap-1 text-xs font-bold text-emerald-400">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={CHECKMARK_ICON_PATH}/></svg>
                    {row.groupPrice}
                  </span>
                </div>
              </div>
            </div>

            {/* ═══ DESKTOP ROW ═══ */}
            <div class="hidden md:flex items-center col-span-5 py-4 px-6">
              <div class="flex items-center gap-3">
                <div class={`w-8 h-8 rounded-lg ${iconBg} flex items-center justify-center shrink-0`}>
                  <svg class={`w-4 h-4 ${iconText} fill-current`} viewBox="0 0 24 24"><path d={icon}/></svg>
                </div>
                <div>
                  <span class="text-slate-200 font-semibold text-sm">{row.name}</span>
                  <span class="block text-xs text-slate-500">{row.subtitle}</span>
                </div>
              </div>
            </div>
            <div class="hidden md:flex items-center justify-center col-span-3 py-4 px-4 bg-stripes-slate text-sm">
              <span class="inline-flex items-center gap-1.5 text-slate-500 font-medium">
                {hasPrice && (
                  <svg class="w-3.5 h-3.5 text-red-400/60 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={CROSS_ICON_PATH}/></svg>
                )}
                {row.individualPrice}
              </span>
            </div>
            <div class="hidden md:flex items-center justify-center col-span-4 py-4 px-4 bg-gemini-950/20 border-l border-gemini-800/30 text-sm transition-colors group-hover:bg-gemini-950/40">
              <span class="inline-flex items-center gap-1.5 text-emerald-400 font-bold">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={CHECKMARK_ICON_PATH}/></svg>
                {row.groupPrice}
              </span>
            </div>
          </div>
        );
      })}

      {/* ═══ FILA TOTAL ═══ */}
      <div class="grid grid-cols-1 md:grid-cols-12 md:gap-0 border border-slate-800/70 md:border-t-2 md:border-slate-700 bg-slate-950/95 rounded-2xl md:rounded-none md:rounded-b-2xl overflow-hidden">
        {/* Mobile: total card */}
        <div class="md:hidden p-5">
          <span class="block text-sm font-extrabold text-white text-center mb-4">{pc.totalLabel}</span>
          <div class="grid grid-cols-2 gap-3">
            <div class="flex flex-col items-center p-3 rounded-xl bg-red-950/15 border border-red-900/25">
              <span class="text-[9px] px-2 py-0.5 rounded-full bg-red-500/15 text-red-400 font-bold border border-red-500/25 mb-2">CARO</span>
              <span class="text-base font-extrabold text-red-400/80 line-through">${marketTotal.toLocaleString("es-AR")} ARS</span>
              <span class="text-[10px] text-slate-500 mt-1">{pc.totalIndividualLabel}</span>
            </div>
            <div class="flex flex-col items-center p-3 rounded-xl bg-gemini-950/30 border border-gemini-500/30">
              <span class="text-[9px] px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 font-bold border border-emerald-500/25 mb-2">MEJOR PRECIO</span>
              <span class="text-xl font-extrabold text-white">${monthlyFee}</span>
              <span class="text-xs text-slate-400">{pc.totalGroupLabel}</span>
              <span class="text-[11px] text-emerald-400 font-bold mt-1">{pc.savingsLabel}</span>
            </div>
          </div>
        </div>

        {/* Desktop: total row */}
        <div class="hidden md:flex items-center col-span-5 py-5 px-6">
          <span class="text-lg font-extrabold text-white tracking-tight">{pc.totalLabel}</span>
        </div>
        <div class="hidden md:flex flex-col items-center justify-center col-span-3 py-5 px-4 bg-red-950/15">
          <div class="flex items-center gap-2 mb-0.5">
            <span class="text-xs px-2 py-0.5 rounded-full bg-red-500/15 text-red-400 font-bold border border-red-500/25">CARO</span>
          </div>
          <span class="text-xl sm:text-2xl font-extrabold text-red-400/80 line-through decoration-red-500/40 decoration-2">
            ${marketTotal.toLocaleString("es-AR")} ARS
          </span>
          <span class="text-[10px] text-slate-500 mt-1">{pc.totalIndividualLabel}</span>
        </div>
        <div class="hidden md:flex flex-col items-center justify-center col-span-4 py-5 px-4 bg-gemini-950/30 border-l-2 border-gemini-500 relative overflow-hidden">
          <div class="absolute inset-0 bg-linear-to-br from-gemini-500/8 via-transparent to-purple-500/5 pointer-events-none"></div>
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-40 h-20 bg-gemini-500/10 rounded-full blur-[40px] pointer-events-none"></div>
          <div class="relative z-10 flex flex-col items-center">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 font-bold border border-emerald-500/25">MEJOR PRECIO</span>
            </div>
            <span class="text-3xl sm:text-4xl font-extrabold text-white">${monthlyFee}</span>
            <span class="text-sm font-semibold text-slate-400">{pc.totalGroupLabel}</span>
            <span class="inline-flex items-center gap-1.5 mt-2 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-xs font-bold animate-glow-pulse">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={CHECKMARK_ICON_PATH}/></svg>
              {pc.savingsLabel}
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Sub-CTA -->
    <div class="mt-10 text-center">
      <a
        href={waLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-8 py-3.5 rounded-xl bg-linear-to-r from-gemini-500 to-purple-600 text-white font-bold text-base hover:from-gemini-600 hover:to-purple-700 transition-all duration-300 shadow-lg shadow-gemini-500/20 hover:shadow-gemini-500/35 hover:-translate-y-0.5"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d={WHATSAPP_ICON_PATH}/></svg>
        {pc.ctaText}
      </a>
      <p class="text-xs text-slate-500 mt-3">{pc.ctaDisclaimer}</p>
    </div>
  </div>
</section>
