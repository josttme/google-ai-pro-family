---
import copy from "../data/copy.json";
import { buildWhatsAppLink } from "../lib/whatsapp";

const waLink = buildWhatsAppLink();
---

<section class="py-20 md:py-28 px-4 sm:px-6 max-w-7xl mx-auto">
  <!-- Encabezado -->
  <div class="text-center mb-16 md:mb-20">
    <span class="inline-block text-xs font-bold tracking-[0.2em] text-slate-500 uppercase mb-4">
      {copy.privacy.badge}
    </span>
    <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight mb-5">
      {copy.privacy.title}
    </h2>
    <p class="text-slate-400 text-base sm:text-lg max-w-3xl mx-auto leading-relaxed mb-4">
      {copy.privacy.subtitle}
    </p>
  </div>

  <!-- Cards de garantía -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-16">
    {
      copy.privacy.badges.map((badge) => (
        <div
          class="group bg-slate-900/70 border border-slate-800/70 rounded-2xl p-6 hover:border-purple-500/40 transition-all duration-300 card-lift relative overflow-hidden"
        >
          <div class="absolute top-0 right-0 w-32 h-32 bg-purple-500/5 rounded-full blur-[60px] pointer-events-none group-hover:bg-purple-500/10 transition-all"></div>
          <div class="relative z-10">
            <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/25 flex items-center justify-center mb-4 text-lg">
              {badge.icon}
            </div>
            <h4 class="text-white font-bold text-base mb-2">{badge.title}</h4>
            <p class="text-slate-400 text-sm leading-relaxed">{badge.description}</p>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Garantía principal -->
  <div class="max-w-4xl mx-auto">
    <div class="bg-linear-to-br from-purple-950/40 via-slate-900/80 to-slate-900/80 border border-purple-500/25 rounded-3xl p-8 sm:p-10 relative overflow-hidden glow-ring-indigo">
      <div class="absolute top-0 right-0 w-80 h-80 bg-purple-500/8 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="relative z-10">
        <p class="text-slate-200 text-base sm:text-lg leading-relaxed font-medium">
          {copy.privacy.description}
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center gap-4">
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto text-center px-8 py-3.5 rounded-xl bg-linear-to-r from-gemini-500 to-purple-600 text-white font-bold text-base hover:from-gemini-600 hover:to-purple-700 transition-all duration-300 shadow-lg shadow-gemini-500/20"
          >
            {copy.privacy.guaranteeCtaText}
          </a>
          <p class="text-xs text-slate-500 text-center sm:text-left">
            {copy.privacy.guaranteeDisclaimer}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
