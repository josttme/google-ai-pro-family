---
// ═══════════════════════════════════════════════════════════════════
// StorageWorkspaceSection — Almacenamiento + Productividad Workspace
// Reemplaza a BentoGrid. Solo cubre lo que NO tiene sección visual propia.
// ═══════════════════════════════════════════════════════════════════
import { buildWhatsAppLink, WHATSAPP_ICON_PATH } from "../lib/whatsapp";

const waLink = buildWhatsAppLink();
---

<section class="py-20 md:py-28 px-4 sm:px-6 max-w-7xl mx-auto">
  <!-- ═══ ENCABEZADO ═══ -->
  <div class="text-center mb-16 md:mb-20">
    <span class="inline-block text-xs font-bold tracking-[0.2em] text-slate-500 uppercase mb-4">
      Y además
    </span>
    <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight mb-5">
      Almacenamiento ilimitado y productividad con IA
    </h2>
    <p class="text-slate-400 text-base sm:text-lg max-w-3xl mx-auto leading-relaxed">
      Dos beneficios gigantes que transforman tu día a día. Sin pagar de más.
    </p>
  </div>

  <!-- ═══ GRID 2 COLUMNAS ═══ -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
    <!-- ═══ CARD 1: STORAGE ═══ -->
    <div class="group relative overflow-hidden rounded-3xl border border-sky-500/30 bg-slate-900/70 p-8 sm:p-10 card-lift">
      <div class="absolute top-0 right-0 w-72 h-72 bg-sky-500/8 rounded-full blur-[100px] pointer-events-none group-hover:bg-sky-500/15 transition-all duration-700"></div>

      <div class="relative z-10">
        <!-- Icono -->
        <div class="w-14 h-14 rounded-2xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="12" cy="5" rx="9" ry="3"/>
            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
          </svg>
        </div>

        <span class="inline-block px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-sky-500/15 text-sky-300 border border-sky-500/20 mb-4">
          ☁️ Almacenamiento
        </span>

        <h3 class="text-2xl sm:text-3xl font-bold text-white mb-3">
          5 TB de espacio para nunca más borrar nada
        </h3>

        <!-- Métrica visual -->
        <div class="flex items-baseline gap-2 mb-3">
          <span class="text-5xl font-extrabold text-sky-400">5.000</span>
          <span class="text-lg font-semibold text-sky-400/70">GB</span>
        </div>

        <p class="text-slate-400 text-sm leading-relaxed mb-6">
          Suficiente para <strong class="text-slate-200">todas tus fotos en calidad original</strong>, todos tus archivos de Drive, todos los adjuntos de Gmail y backups de tu Android. Sin preocuparte por la barrita de espacio nunca más.
        </p>

        <!-- Mini-features -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-sky-950/40 border border-sky-800/30 text-xs text-sky-300 font-medium">
            <svg class="w-3.5 h-3.5 text-sky-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            Fotos en calidad original
          </div>
          <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-sky-950/40 border border-sky-800/30 text-xs text-sky-300 font-medium">
            <svg class="w-3.5 h-3.5 text-sky-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            Backup automático Android
          </div>
          <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-sky-950/40 border border-sky-800/30 text-xs text-sky-300 font-medium">
            <svg class="w-3.5 h-3.5 text-sky-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            Gmail sin límites
          </div>
          <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-sky-950/40 border border-sky-800/30 text-xs text-sky-300 font-medium">
            <svg class="w-3.5 h-3.5 text-sky-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            100% privado
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ CARD 2: WORKSPACE ═══ -->
    <div class="group relative overflow-hidden rounded-3xl border border-emerald-500/30 bg-slate-900/70 p-8 sm:p-10 card-lift">
      <div class="absolute top-0 right-0 w-72 h-72 bg-emerald-500/8 rounded-full blur-[100px] pointer-events-none group-hover:bg-emerald-500/15 transition-all duration-700"></div>

      <div class="relative z-10">
        <!-- Icono -->
        <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/>
          </svg>
        </div>

        <span class="inline-block px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-500/15 text-emerald-300 border border-emerald-500/20 mb-4">
          ⚡ Productividad
        </span>

        <h3 class="text-2xl sm:text-3xl font-bold text-white mb-3">
          Gemini integrado en las apps que usás todos los días
        </h3>

        <p class="text-slate-400 text-sm leading-relaxed mb-6">
          No necesitás abrir una app nueva. <strong class="text-slate-200">Gemini ya está dentro de Gmail, Docs y Sheets</strong>. Redacta correos, resume documentos, analiza datos y crea fórmulas sin salir de tu espacio de trabajo.
        </p>

        <!-- Apps: Gmail, Docs, Sheets -->
        <div class="grid grid-cols-3 gap-3 mb-6">
          <div class="flex flex-col items-center gap-2 p-4 rounded-xl bg-emerald-950/30 border border-emerald-800/30">
            <svg class="w-8 h-8 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 4l-10 8L2 4"/>
            </svg>
            <span class="text-[10px] font-semibold text-emerald-300">Gmail</span>
          </div>
          <div class="flex flex-col items-center gap-2 p-4 rounded-xl bg-emerald-950/30 border border-emerald-800/30">
            <svg class="w-8 h-8 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/>
            </svg>
            <span class="text-[10px] font-semibold text-emerald-300">Docs</span>
          </div>
          <div class="flex flex-col items-center gap-2 p-4 rounded-xl bg-emerald-950/30 border border-emerald-800/30">
            <svg class="w-8 h-8 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/>
            </svg>
            <span class="text-[10px] font-semibold text-emerald-300">Sheets</span>
          </div>
        </div>

        <!-- Mini-features -->
        <div class="space-y-2">
          <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-emerald-950/40 border border-emerald-800/30 text-xs text-emerald-300 font-medium">
            <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            Redactá correos profesionales en segundos
          </div>
          <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-emerald-950/40 border border-emerald-800/30 text-xs text-emerald-300 font-medium">
            <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            Resumí documentos largos con un clic
          </div>
          <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-emerald-950/40 border border-emerald-800/30 text-xs text-emerald-300 font-medium">
            <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            Creá fórmulas y analizá datos en Sheets
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
