---

{
  icon.fill ? (
    <svg class={className} viewBox={icon.viewBox} fill={icon.fill} aria-hidden="true" focusable="false" width={size} height={size}>
      <set:html html={icon.paths} />
    </svg>
  ) : (
    <svg class={className} viewBox={icon.viewBox} fill="none" stroke={icon.stroke ?? "currentColor"} stroke-width={icon.strokeWidth ?? 2} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" width={size} height={size}>
      <set:html html={icon.paths} />
    </svg>
  )
}
